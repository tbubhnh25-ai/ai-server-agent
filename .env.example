# טוקן לאימות קריאות ל-API של הסוכן
AGENT_AUTH_TOKEN=change-me-to-a-random-secret

# ספק ה-LLM: ollama (חינמי, מקומי) | groq (חינמי עם מפתח API) | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1

# כתובת שרת Ollama (כשה-provider הוא ollama)
OLLAMA_BASE_URL=http://ollama:11434

# מפתח API (רק אם LLM_PROVIDER=groq או openai, לא נדרש ל-ollama)
LLM_API_KEY=

# תמונת הדוקר שבתוכה רצות פקודות הסוכן (sandbox)
SANDBOX_IMAGE=agent-sandbox:latest

# תיקיית העבודה המשותפת בין השרת לבין ה-sandbox
WORKSPACE_DIR=/workspace

# הגבלות ריצה
MAX_LOOP_ITERATIONS=15
SHELL_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

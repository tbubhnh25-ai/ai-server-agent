# טוקן לאימות קריאות ל-API של הסוכן
AGENT_AUTH_TOKEN=change-me-to-a-random-secret

# ספק ה-LLM: groq (חינמי עם מפתח API) | gemini (חינמי עם מפתח API)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# מפתח API: groq.com/keys או aistudio.google.com/apikey (בהתאם ל-LLM_PROVIDER)
LLM_API_KEY=

# תיקיית העבודה המשותפת שהסוכן קורא/כותב אליה
WORKSPACE_DIR=/app/workspace

# הגבלות ריצה
MAX_LOOP_ITERATIONS=15
SHELL_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT_MB=512
